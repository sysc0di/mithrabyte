// Mithrabyte data model — phased foundation.
// Phase 0 core: auth, catalog (products/categories), service packages &
// maintenance plans, editable pages/sections, site settings, contact inquiries,
// analytics events, audit log. Feature-specific tables are added in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication & administration
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  OWNER
}

model Admin {
  id                 String        @id @default(cuid())
  email              String        @unique
  name               String
  passwordHash       String
  role               AdminRole     @default(ADMIN)
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sessions           AdminSession[]
  auditLogs          AuditLog[]

  @@map("admins")
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  lastUsedAt DateTime @default(now())
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Records login attempts for rate limiting and audit.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String?
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

/// Generic per-IP request volume log used for public endpoint rate limits.
model RequestLog {
  id        String   @id @default(cuid())
  scope     String // e.g. "contact", "analytics"
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([scope, ipHash, createdAt])
  @@map("request_logs")
}

/// Immutable audit trail for sensitive administrative operations.
model AuditLog {
  id        String   @id @default(cuid())
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId   String?
  action    String // e.g. "create", "update", "delete", "login", "logout", "password.change"
  entity    String // e.g. "product", "admin", "session", "setting"
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog: categories, products, features, localized content
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  locales   CategoryLocale[]
  products  Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model CategoryLocale {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String?

  @@unique([categoryId, locale])
  @@map("category_locales")
}

enum ProductStatus {
  DRAFT
  UPCOMING
  AVAILABLE
  ARCHIVED
}

model Product {
  id         String        @id @default(cuid())
  slug       String        @unique
  status     ProductStatus @default(DRAFT)
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  locales    ProductLocale[]
  features   ProductFeature[]
  packages   ServicePackage[]

  @@index([status, sortOrder])
  @@index([categoryId])
  @@map("products")
}

model ProductLocale {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           String
  title            String
  tagline          String  @default("")
  shortDescription String  @default("")
  description      String  @default("")
  targetAudience   String  @default("")
  /// Structured localized extras (e.g. { "useCases": [{ "title", "description" }] }).
  useCases         Json?
  ctaText          String?
  seoTitle         String?
  seoDescription   String?

  @@unique([productId, locale])
  @@map("product_locales")
}

model ProductFeature {
  id        String                @id @default(cuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int                   @default(0)
  locales   ProductFeatureLocale[]

  @@index([productId])
  @@map("product_features")
}

model ProductFeatureLocale {
  id        String          @id @default(cuid())
  featureId String
  feature   ProductFeature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  locale    String
  text      String

  @@unique([featureId, locale])
  @@map("product_feature_locales")
}

// ---------------------------------------------------------------------------
// Service packages & maintenance plans
// ---------------------------------------------------------------------------

enum ServiceKind {
  PACKAGE
  MAINTENANCE
}

/// Publication state for service packages. Only AVAILABLE packages are public.
enum ServiceStatus {
  DRAFT
  AVAILABLE
  ARCHIVED
}

/// How a package is priced. QUOTE means "priced per project after scoping".
enum PricingModel {
  QUOTE
  FIXED
}

/// One-time delivery vs. recurring subscription (e.g. maintenance plans).
enum BillingPeriod {
  ONE_TIME
  MONTHLY
  YEARLY
}

model ServicePackage {
  id           String          @id @default(cuid())
  slug         String          @unique
  kind         ServiceKind     @default(PACKAGE)
  status       ServiceStatus   @default(DRAFT)
  /// Optional owning product; a package can also stand alone.
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  pricingModel PricingModel    @default(QUOTE)
  billingPeriod BillingPeriod  @default(ONE_TIME)
  priceAmount  Decimal?        @db.Decimal(12, 2)
  currency     String?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  locales      ServicePackageLocale[]
  features     PackageFeature[]

  @@index([kind, status, sortOrder])
  @@index([productId])
  @@map("service_packages")
}

model ServicePackageLocale {
  id             String         @id @default(cuid())
  packageId      String
  package        ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  locale         String
  title          String
  tagline        String         @default("")
  description    String         @default("")
  priceLabel     String         @default("")
  ctaText        String?
  seoTitle       String?
  seoDescription String?
  /// Structured localized extras (e.g. { "useCases": [...] }).
  data           Json?

  @@unique([packageId, locale])
  @@map("service_package_locales")
}

model PackageFeature {
  id        String            @id @default(cuid())
  packageId String
  package   ServicePackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sortOrder Int               @default(0)
  locales   PackageFeatureLocale[]

  @@index([packageId])
  @@map("package_features")
}

model PackageFeatureLocale {
  id        String           @id @default(cuid())
  featureId String
  feature   PackageFeature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  locale    String
  text      String

  @@unique([featureId, locale])
  @@map("package_feature_locales")
}

// ---------------------------------------------------------------------------
// Editable content: pages, sections, settings
// ---------------------------------------------------------------------------

model Page {
  id        String   @id @default(cuid())
  key       String   @unique
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  locales   PageLocale[]
  sections  Section[]

  @@map("pages")
}

model PageLocale {
  id            String @id @default(cuid())
  pageId        String
  page          Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale        String
  title         String @default("")
  subtitle      String @default("")
  body          String @default("")
  seoTitle      String?
  seoDescription String?

  @@unique([pageId, locale])
  @@map("page_locales")
}

model Section {
  id        String        @id @default(cuid())
  pageId    String
  page      Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  sortOrder Int           @default(0)
  locales   SectionLocale[]

  @@unique([pageId, key])
  @@map("sections")
}

model SectionLocale {
  id        String  @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  locale    String
  title     String  @default("")
  body      String  @default("")

  @@unique([sectionId, locale])
  @@map("section_locales")
}

model Setting {
  id          String         @id @default(cuid())
  key         String         @unique
  /// Protected settings cannot be edited through the admin API.
  isProtected Boolean        @default(false)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  values      SettingValue[]

  @@map("settings")
}

model SettingValue {
  id        String  @id @default(cuid())
  settingId String
  setting   Setting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  /// ISO locale (e.g. "tr", "en") or the sentinel "*" for non-localized values.
  locale    String
  value     Json

  @@unique([settingId, locale])
  @@map("setting_values")
}

// ---------------------------------------------------------------------------
// Contact inquiries & replies
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  SPAM
  ARCHIVED
}

model Inquiry {
  id        String         @id @default(cuid())
  name      String
  email     String
  company   String?
  subject   String?
  message   String
  pageRef   String?
  locale    String?
  status    InquiryStatus  @default(NEW)
  adminNote String?
  ipHash    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  replies   InquiryReply[]

  @@index([status, createdAt])
  @@index([email])
  @@map("inquiries")
}

model InquiryReply {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromName  String   @default("Mithrabyte")
  fromEmail String
  subject   String
  body      String
  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@map("inquiry_replies")
}

// ---------------------------------------------------------------------------
// First-party analytics
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String   @default("/")
  referrer  String?
  locale    String?
  device    String?
  sessionId String?
  ipHash    String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}