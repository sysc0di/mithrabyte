# ------------------------------------------------------------------
# Mithrabyte environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# PostgreSQL connection string (Prisma).
# Local docker-compose development value:
DATABASE_URL="postgresql://mithrabyte:mithrabyte@localhost:5432/mithrabyte"
# Production: point to your hosted/managed PostgreSQL instance, e.g.
#   postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
# Prisma migrations use DATABASE_URL unless PRISMA_DATABASE_URL is set.

# ------------------------------------------------------------------
# Initial administrator (used by `npm run db:seed`)
# ------------------------------------------------------------------
# Email of the initial administrator account.
ADMIN_INIT_EMAIL="admin@mithrabyte.com"
# Password of the initial administrator account (min 12 chars, Argon2id hashed).
# Provide via a secret manager in production; the seed is idempotent and will
# NOT overwrite an existing admin's password.
ADMIN_INIT_PASSWORD="change-me-to-a-long-random-password"
# Display name of the initial administrator.
ADMIN_INIT_NAME="Mithrabyte Admin"

# ------------------------------------------------------------------
# Optional runtime settings
# ------------------------------------------------------------------
# When "1", enables Argon2 hashing with reduced cost only in non-production
# environments for faster local workflows. Ignored in production.
# ARGON2_LOOSE_COST="0"

# Session lifetime in days (default: 30).
# ADMIN_SESSION_TTL_DAYS="30"

# Contact form: max accepted requests per IP per hour (default: 10).
# CONTACT_RATE_LIMIT="10"

# Analytics ingestion: max accepted events per IP per minute (default: 120).
# ANALYTICS_RATE_LIMIT="120"

# Comma-separated list of enabled UI locales for localized content editing.
# SUPPORTED_LOCALES="tr,en"

# Public site URL, used for canonical metadata and admin "view site" links.
# NEXT_PUBLIC_SITE_URL="https://mithrabyte.com"

# --- Optional contact-form email notifications -------------------------------
# Leave unset to disable notifications (messages are always stored regardless).
# RESEND_API_KEY="re_xxxxxxxx"
# INQUIRY_FROM_EMAIL="Mithrabyte <notifications@mithrabyte.com>"
# INQUIRY_NOTIFY_EMAIL="contact@mithrabyte.com"

# --- Hostinger SMTP (required to send replies from Admin > Inbox) ------------
# Create a mailbox in hPanel, then use its full email address and password.
# Hostinger's standard SMTP host is smtp.hostinger.com. Use port 465 with
# SMTP_SECURE=true, or port 587 with SMTP_SECURE=false (STARTTLS).
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="contact@mithrabyte.com"
# SMTP_PASSWORD="your-hostinger-mailbox-password"
# SMTP_FROM_EMAIL="contact@mithrabyte.com"
# SMTP_FROM_NAME="Mithrabyte"
